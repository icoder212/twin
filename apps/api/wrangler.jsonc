// Cloudflare Worker for the Desk Twin server. Settings specific to one deployment (accounts,
// phone numbers, keys) are secrets, never committed: see .dev.vars.example and README.md.
{
  "name": "desk-twin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "desk-twin",
      "database_id": "a6a03907-d257-4ee4-be36-2cb61dfb0bd4",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // WhatsApp goes through Twilio. Until the account has its own approved WhatsApp sender, the
    // sandbox number delivers only within 24 hours of a message from the owner's phone.
    "WHATSAPP_PROVIDER": "twilio",
    "TWILIO_WHATSAPP_FROM": "+14155238886",
    "TWILIO_REMINDER_CONTENT_SID": "HXca690c94b031bf36d72f371140687c7b",
    "TWILIO_UPDATE_CONTENT_SID": "HX74287113de3bc1607908b032b114caea",
    // WhatsApp stops sending when the Twilio balance reaches this (GBP), capping spend.
    "TWILIO_MIN_BALANCE": "10",
    // Until then, a reminder at this time each evening asks you to reply on WhatsApp.
    "SANDBOX_REMINDER_AT": "22:30",
    "TWILIO_STATUS_CALLBACK_URL": "https://desk-twin-api.withered-disk-7504.workers.dev/twilio/status",
    "WHATSAPP_TEMPLATE": "meeting_reminder",
    "WHATSAPP_UPDATE_TEMPLATE": "release_update",
    "WHATSAPP_TEMPLATE_LANGUAGE": "en_GB",
    "GRAPH_API_VERSION": "v26.0",
    "REMINDER_MINUTES": "10",
    "TIMEZONE": "Europe/London",
    "APP_ORIGINS": "https://twin.alchmai.com,https://twin-umber-nu.vercel.app,http://localhost:5173",
    "RESEND_FROM": "Desk Twin <onboarding@resend.dev>",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CLAUDE_FILTER_MODEL": "claude-haiku-5-5",
  },
  "observability": { "enabled": true },
}
