# Copy to .dev.vars (git ignores it) and fill in. Upload to Cloudflare with:
#   npx wrangler@4.152.0 secret bulk .dev.vars
# Never commit the filled-in file or paste these values into chat.

# The only Google account this server will connect (the owner's).
OWNER_GOOGLE_ACCOUNT=
# Google Auth Platform > Clients > Desk Twin web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_KEY=

# Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent system-user token with whatsapp_business_messaging.
WHATSAPP_TOKEN=
# App settings > Basic > App secret (checks that webhooks really come from Meta).
WHATSAPP_APP_SECRET=
# Any long random string; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Your WhatsApp number in international format, digits only, e.g. 447700900123.
WHATSAPP_TO=

# Resend > API Keys > a key with Sending access. Optional: without it, email is reported as not set up.
RESEND_API_KEY=

# console.anthropic.com > API Keys. Optional: without it, the app offers the settings to tick instead.
ANTHROPIC_API_KEY=
# fredaccount.stlouisfed.org/apikeys (free). Optional: without it, only the Fed decision is scheduled.
FRED_API_KEY=
# data.bls.gov/registrationEngine (free). Optional: CPI, PPI and jobs figures at release time.
BLS_API_KEY=
# alpaca.markets > free account > API keys (paper trading is fine). Optional: Benzinga headlines.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
