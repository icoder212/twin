# Public build-time configuration only. Never put secrets in VITE_ variables:
# they are compiled into the JavaScript bundle and visible to anyone.

# "mock" runs the in-browser demo backend. "http" will call the real API.
VITE_API_MODE=mock
# Required when VITE_API_MODE=http. Must be https outside local development.
VITE_API_BASE_URL=
# Shows demo credentials on the sign-in page and enables the white-label switcher.
VITE_DEMO_MODE=true
# Tenant used when the hostname does not map to one (alchmai, northbridge, meridian).
VITE_DEFAULT_TENANT=alchmai
# Comma-separated https origins allowed to embed the app in an iframe.
VITE_EMBED_ALLOWED_ORIGINS=
